{
    "openapi": "3.0.0",
    "info": {
        "title": "MathHub API",
        "description": "MathHub 後端 API 規格文件",
        "version": "1.0.0 20250726",
        "contact": {
            "name": "MathHub"
        }
    },
    "servers": [
        {
            "url": "https://nodehub.pod042a.ddns-ip.net",
            "description": "Pod042-A 開發環境"
        }
    ],
    "components": {
        "parameters": {
            "ContentTypeHeader": {
                "name": "Content-Type",
                "in": "header",
                "required": true,
                "schema": {
                    "type": "string",
                    "default": "application/json"
                },
                "description": "請求內容類型"
            },
            "LimitParam": {
                "name": "limit",
                "in": "query",
                "required": false,
                "schema": {
                    "type": "integer",
                    "default": 10
                },
                "description": "欲查詢每頁分頁時的數量, 0 代表查詢 DB 裡所有符合 filter 條件的資料"
            },
            "SkipParam": {
                "name": "skip",
                "in": "query",
                "required": false,
                "schema": {
                    "type": "integer",
                    "default": 0
                },
                "description": "跳過前 N 個數量, 0 代表從第一筆開始查詢, 邏輯是依靠 limit * (page - 1) 處理分頁資料流"
            },
            "FilterParam": {
                "name": "filter",
                "in": "query",
                "required": false,
                "schema": {
                    "type": "string",
                    "default": "{ 'title': 'test', 'createdAt': { 'gt': 1750430295000 } }"
                },
                "description": "過濾搜尋資料條件, 由 { key: value } 組成, 可以多個過濾條件, 確認是否可以用 MongoDB 語法?"
            },
            "SortParam": {
                "name": "sort",
                "in": "query",
                "required": false,
                "schema": {
                    "type": "string",
                    "default": "{ 'createdAt': -1 }"
                },
                "description": "排序資料, 由 { key: value } 組成, value 為 -1 代表 由大到小排序, 1 由小到大排序"
            },
            "ProjectionParam": {
                "name": "projection",
                "in": "query",
                "required": false,
                "schema": {
                    "type": "string",
                    "default": "{ 'title': 1, 'createdAt': 1 }"
                },
                "description": "資料投影處理, 由 { key: value } 組成, value 為 1 代表查詢, 0 代表不查詢, 不能混合 1 和 0 的設定"
            }
        },
        "schemas": {
            "User": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "example": "4fcd0ed2-0000-0000-0000-283b3841e6ea"
                    },
                    "name": {
                        "type": "string",
                        "example": "張三"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "user@example.com"
                    },
                    "permissionList": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "isActivated",
                            "allowLogin",
                            "allowGetQuestList",
                            "allowGetQuestData",
                            "allowAnswerQuest"
                        ],
                        "description": "先做用戶針對後台權限功能, [action]:[page] 組成, 例如 get:question 代表可以看到問題頁面, put:question 代表可以新增問題"
                    },
                    "birthday": {
                        "type": "integer",
                        "nullable": true,
                        "format": "timestamp",
                        "example": 1750430295000
                    },
                    "grade": {
                        "type": "string",
                        "nullable": true,
                        "example": "國小一年級",
                        "description": "用戶年級, 這邊需再定義資料欄位"
                    },
                    "isActive": {
                        "type": "boolean",
                        "example": true,
                        "description": "用戶是否被停用, 如果被停用則禁止登入"
                    },
                    "createdAt": {
                        "type": "integer",
                        "format": "timestamp",
                        "example": 1750430295000
                    },
                    "updatedAt": {
                        "type": "integer",
                        "format": "timestamp",
                        "example": 1750430295000
                    }
                }
            },
            "Creator": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "example": "user123"
                    },
                    "name": {
                        "type": "string",
                        "example": "張三"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "user@example.com"
                    }
                }
            },
            "NoticeBoard": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "example": "notice123"
                    },
                    "title": {
                        "type": "string",
                        "example": "公告標題"
                    },
                    "content": {
                        "type": "string",
                        "example": "公告內容"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "public",
                            "draft"
                        ],
                        "description": "公告狀態, public 代表已發佈, draft 代表草稿"
                    },
                    "pinOrder": {
                        "type": "integer",
                        "example": 0,
                        "description": "置頂排序, 0 代表不置頂, 數字越大可以代表權重越高越上面, 如果是非置頂的公告, 需要依照 sort 所指定欄位排序"
                    },
                    "creator": {
                        "$ref": "#/components/schemas/Creator"
                    },
                    "scheduleAt": {
                        "type": "integer",
                        "format": "timestamp",
                        "example": 1750430295000,
                        "description": "預約發佈時間, 0 代表直接發佈"
                    },
                    "createdAt": {
                        "type": "integer",
                        "format": "timestamp",
                        "example": 1750430295000
                    },
                    "updatedAt": {
                        "type": "integer",
                        "format": "timestamp",
                        "example": 1750430295000
                    }
                }
            },
            "NoticeBoardRequest": {
                "type": "object",
                "required": [
                    "title",
                    "status"
                ],
                "properties": {
                    "title": {
                        "type": "string",
                        "example": "公告標題"
                    },
                    "content": {
                        "type": "string",
                        "example": "公告內容"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "public",
                            "draft"
                        ],
                        "description": "公告狀態, public 代表已發佈, draft 代表草稿"
                    },
                    "pinOrder": {
                        "type": "integer",
                        "example": 0,
                        "description": "置頂排序, 0 代表不置頂, 數字越大可以代表權重越高越上面, 如果是非置頂的公告, 需要依照 sort 所指定欄位排序"
                    },
                    "scheduleAt": {
                        "type": "integer",
                        "format": "timestamp",
                        "example": 1750430295000,
                        "description": "預約發佈時間, 0 代表直接發佈"
                    }
                }
            },
            "RegisterRequest": {
                "type": "object",
                "required": [
                    "email",
                    "password",
                    "username"
                ],
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "user@example.com"
                    },
                    "password": {
                        "type": "string",
                        "example": "password123!"
                    },
                    "username": {
                        "type": "string",
                        "example": "user123"
                    }
                }
            },
            "LoginRequest": {
                "type": "object",
                "required": [
                    "email",
                    "password",
                    "deviceID"
                ],
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "user@example.com"
                    },
                    "password": {
                        "type": "string",
                        "example": "p@ssw0rd123"
                    },
                    "deviceID": {
                        "type": "string",
                        "example": "4fcd0ed2-0000-0000-0000-283b3841e6ea"
                    },
                    "nonce": {
                        "type": "string",
                        "nullable": true,
                        "description": "（可選）用於防止重播攻擊的隨機字串，由前端產生"
                    }
                }
            },
            "LoginResponse": {
                "type": "object",
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": true
                    },
                    "data": {
                        "type": "object",
                        "properties": {
                            "accessToken": {
                                "type": "string",
                                "description": "JWT 格式的存取令牌",
                                "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                            },
                            "idToken": {
                                "type": "string",
                                "description": "JWT 格式的識別令牌",
                                "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                            },
                            "expiresIn": {
                                "type": "integer",
                                "description": "存取令牌的有效秒數",
                                "example": 3600
                            },
                            "user": {
                                "$ref": "#/components/schemas/User"
                            }
                        }
                    }
                }
            },
            "SuccessResponse": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "操作成功"
                    },
                    "success": {
                        "type": "boolean",
                        "example": true
                    },
                    "data": {
                        "type": "object",
                        "properties": {}
                    }
                }
            },
            "400ErrorResponse": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "invalid params"
                    },
                    "status": {
                        "type": "string",
                        "example": "failed"
                    },
                    "data": {
                        "type": "object",
                        "properties": {}
                    }
                }
            },
            "401ErrorResponse": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "unauthorized"
                    },
                    "status": {
                        "type": "string",
                        "example": "failed"
                    },
                    "data": {
                        "type": "object",
                        "properties": {}
                    }
                }
            },
            "403ErrorResponse": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "forbidden"
                    },
                    "status": {
                        "type": "string",
                        "example": "failed"
                    },
                    "data": {
                        "type": "object",
                        "properties": {}
                    }
                }
            },
            "5XXErrorResponse": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "server error"
                    },
                    "status": {
                        "type": "string",
                        "example": "failed"
                    },
                    "data": {
                        "type": "object",
                        "properties": {}
                    }
                }
            }
        },
        "securitySchemes": {
            "BearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        }
    },
    "paths": {
        "/admin/noticeBoards": {
            "get": {
                "tags": [
                    "公告"
                ],
                "summary": "獲取公告列表",
                "description": "獲取當前分頁所有公告列表",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/ContentTypeHeader"
                    },
                    {
                        "$ref": "#/components/parameters/AuthorizationHeader"
                    },
                    {
                        "$ref": "#/components/parameters/LimitParam"
                    },
                    {
                        "$ref": "#/components/parameters/SkipParam"
                    },
                    {
                        "$ref": "#/components/parameters/FilterParam"
                    },
                    {
                        "$ref": "#/components/parameters/SortParam"
                    },
                    {
                        "$ref": "#/components/parameters/ProjectionParam"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "成功獲取公告列表",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "成功獲取公告列表"
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/NoticeBoard"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "請求格式錯誤",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/400ErrorResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "未授權",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/401ErrorResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "伺服器錯誤",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/5XXErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/admin/noticeBoards/{id}": {
            "get": {
                "tags": [
                    "公告"
                ],
                "summary": "獲取指定 id 單一公告",
                "description": "獲取指定 id 單一公告",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "$ref": "#/components/parameters/ContentTypeHeader"
                    },
                    {
                        "$ref": "#/components/parameters/AuthorizationHeader"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "成功獲取指定 id 單一公告",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "成功獲取指定 id 單一公告"
                                        },
                                        "data": {
                                            "$ref": "#/components/schemas/NoticeBoard"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "請求格式錯誤",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/400ErrorResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "未授權",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/401ErrorResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "伺服器錯誤",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/5XXErrorResponse"
                                }
                            }
                        }
                    }
                }
            },
            "patch": {
                "tags": [
                    "公告"
                ],
                "summary": "更新指定 id 單一公告",
                "description": "更新指定 id 單一公告",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "$ref": "#/components/parameters/ContentTypeHeader"
                    },
                    {
                        "$ref": "#/components/parameters/AuthorizationHeader"
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "oneOf": [
                                    {
                                        "$ref": "#/components/schemas/NoticeBoardRequest"
                                    },
                                    {
                                        "type": "object",
                                        "properties": {
                                            "status": {
                                                "type": "string",
                                                "enum": [
                                                    "public",
                                                    "draft"
                                                ],
                                                "example": "public"
                                            }
                                        }
                                    }
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "成功更新指定 id 單一公告",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "成功更新指定 id 單一公告"
                                        },
                                        "data": {
                                            "$ref": "#/components/schemas/NoticeBoard"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "請求格式錯誤",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/400ErrorResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "未授權",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/401ErrorResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "伺服器錯誤",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/5XXErrorResponse"
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "tags": [
                    "公告"
                ],
                "summary": "刪除指定 id 單一公告",
                "description": "刪除指定 id 單一公告",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "$ref": "#/components/parameters/ContentTypeHeader"
                    },
                    {
                        "$ref": "#/components/parameters/AuthorizationHeader"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "成功刪除指定 id 單一公告",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "成功刪除指定 id 單一公告"
                                        },
                                        "data": {
                                            "type": "object",
                                            "properties": {}
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "請求格式錯誤",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/400ErrorResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "未授權",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/401ErrorResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "伺服器錯誤",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/5XXErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "認證",
            "description": "用戶認證相關 API"
        },
        {
            "name": "公告",
            "description": "公告相關 API"
        }
    ]
}